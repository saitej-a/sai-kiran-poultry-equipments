# Form endpoint for the contact + turnkey inquiry forms.
# Any service that accepts a JSON POST works (Web3Forms, Formspree, Google Apps Script).
# Leave NEXT_PUBLIC_FORM_ENDPOINT blank to fall back to the Web3Forms endpoint.
NEXT_PUBLIC_FORM_ENDPOINT=

# Web3Forms access key. Only used when the fallback endpoint above is active.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Canonical production origin, used for absolute OG / sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://saikiranequipments.in
